{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm install *)",
      "Bash(npx tsc:*)",
      "Bash(git *)",
      "Read(/tmp/**)",
      "Bash(gh auth:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /c/workspace/gatchlycom && npx tsc --noEmit 2>&1 | head -20 || true"
          }
        ]
      }
    ]
  }
}
